# AzimutCP — environment variables
# Copy to .env next to the panel binary (or point the systemd EnvironmentFile here).
# Only DATABASE_URL is mandatory; everything else has sane defaults.

# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://azimutcp:CHANGE_ME@127.0.0.1:5432/azimutcp
VALKEY_URL=redis://127.0.0.1:6379
PANEL_PORT=2087
PANEL_DOMAIN=cp.example.com
ALLOWED_ORIGINS=https://cp.example.com

# community | pro | enterprise
AZIMUT_ENV=community
ADMIN_EMAIL=admin@example.com
SMTP_FROM=noreply@example.com
MAX_UPLOAD_MB=50

# ── JWT (ES256) ───────────────────────────────────────────────────────────────
# Generated automatically on first start if the files do not exist.
JWT_EC_PRIVATE_KEY_PATH=/etc/azimutcp/jwt_ec_key.pem
JWT_EC_PUBLIC_KEY_PATH=/etc/azimutcp/jwt_ec_key.pub.pem

# ── Internal daemons ─────────────────────────────────────────────────────────
AZIMUT_MAIL_URL=http://127.0.0.1:5354
AZIMUT_DNS_URL=http://127.0.0.1:5353
# Shared secret for internal callbacks (git post-receive hook, etc.)
AZIMUT_INTERNAL_TOKEN=CHANGE_ME

# ── ACME / SSL ────────────────────────────────────────────────────────────────
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# ── Limits ────────────────────────────────────────────────────────────────────
AZIMUT_MAX_DATABASES_PER_SITE=10
AZIMUT_MAX_CRON_JOBS_PER_SITE=25
AZIMUT_MAX_EMAIL_ACCOUNTS=100

# ── Apps catalog ──────────────────────────────────────────────────────────────
AZIMUT_APPS_DIR=/etc/azimutcp/apps

# ── azimut-dns ────────────────────────────────────────────────────────────────
PDNS_API_URL=http://127.0.0.1:8081
PDNS_API_KEY=CHANGE_ME
AZIMUT_DNS_LISTEN=127.0.0.1:5353

# ── azimut-mail ───────────────────────────────────────────────────────────────
AZIMUT_MAIL_LISTEN=127.0.0.1:5354

# ── azimut-agent ──────────────────────────────────────────────────────────────
AZIMUT_AGENT_ADDR=0.0.0.0:7443
AGENT_CERT_PATH=/etc/azimutcp/agent/agent.pem
AGENT_KEY_PATH=/etc/azimutcp/agent/agent-key.pem
AGENT_CA_PATH=/etc/azimutcp/agent/ca.pem
AZIMUT_JOURNAL_PATH=/var/lib/azimutcp/agent/journal.db

# ── azimut-cron ───────────────────────────────────────────────────────────────
# Comma-separated "server_id:grpc_url" pairs
AGENT_ENDPOINTS=
ADMIN_ALERT_EMAIL=admin@example.com

# ── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=azimut_panel=info,tower_http=info
